# Copiar a .env
# Los secretos se dejan VACÍOS a propósito, son placeholders para generar en cada equipo.
# Nunca subir .env a Git. No copiar los secretos de otro desarrollador. Asegurate de que .env esté dentro de .gitignore

# --- Puertos de desarrollo ---
PRIVATEWAY_HTTP_PORT=8080
PRIVATEWAY_DEV_FRONTEND_PORT=3000

# --- BFF Next.js <-> Gateway FastAPI ---
# OBLIGATORIO: generar manualmente una clave (openssl rand -hex 32), >= 24 caracteres
PRIVATEWAY_GATEWAY_TOKEN=

# --- Proveedor simulado, sin conexión a una API LLM ---
# 1 habilita el adaptador de demo; 0 lo deshabilita
GATEWAY_DEMO_MODE=1
# 0 mantiene cerrado el puente BFF del chat (valor seguro inicial), se supone que con esto las consultas no salen del sistema
PRIVATEWAY_DEV_CHAT_BRIDGE=0
GATEWAY_ROUTES_JSON={"pw-simulado":{"proveedor":"simulado","modelo_externo":"modelo-demo"}}
GATEWAY_PROVIDERS_JSON={"simulado":{"tipo":"simulado"}}
GATEWAY_ALLOWED_PROVIDER_HOSTS=

# --- Proveedores externos, opcionales: dejar vacíos si no se usan o no se tienen aún (Por ahora no tenemos una API para probar) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- PostgreSQL de conversaciones (perfil Compose 'data') ---
# No es la base de datos de Keycloak; no se requiere en el arranque normal.
PRIVATEWAY_DB_PASSWORD=

# --- Sesiones NextAuth y clientes Keycloak OIDC ---
# OBLIGATORIOS: Ejecuta el script para rellenar el .env con claves generadas: scripts/configurar-keycloak.py.
# Secreto de sesión de NextAuth (>= 32 caracteres)
NEXTAUTH_SECRET=
# Cliente confidencial web de Keycloak: privateway-web
PRIVATEWAY_OIDC_CLIENT_SECRET=
# Cliente de servicio administrativo: privateway-admin-api
PRIVATEWAY_KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Base de datos de Keycloak (independiente de PrivateWay) ---
KEYCLOAK_DB_PASSWORD=

# --- Administrador bootstrap de Keycloak, realm master ---
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Primer administrador de la aplicación, realm privateway ---
PRIVATEWAY_FIRST_ADMIN_USERNAME=pwadmin
# Contraseña TEMPORAL, usada solo al crear pwadmin por primera vez, luego el sistema obliga a cambiarla
PRIVATEWAY_FIRST_ADMIN_PASSWORD=

# NOTAS:
# - El script no genera PRIVATEWAY_GATEWAY_TOKEN; hacerlo manualmente.
# - Las URL NEXTAUTH_URL, PRIVATEWAY_OIDC_ISSUER y clientes OIDC se definen dentro del servicio frontend en compose.yaml; no es necesario duplicarlas aquí.
# - La contraseña que cambia el usuario en Keycloak NO se actualiza en .env.
# - No cambiar claves de PostgreSQL/bootstrap a ciegas cuando ya existan volúmenes.
